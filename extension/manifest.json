{
  "manifest_version": 3,
  "name": "CivicPilot",
  "version": "0.1.0",
  "description": "A privacy-first copilot for government portals.",
  "permissions": ["storage", "sidePanel", "activeTab", "tabs"],
  "host_permissions": ["http://localhost:4000/*", "https://*/*", "http://*/*"],
  "action": { "default_title": "Open CivicPilot" },
  "side_panel": { "default_path": "src/sidepanel/index.html"},
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["assets/overlay.css", "assets/content-D_cTP9w-.css"],
      "run_at": "document_idle"
    }
  ]
}
